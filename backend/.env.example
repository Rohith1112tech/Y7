# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# Database (MongoDB Atlas Connection String)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/studioy7?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_jwt_private_secret_key_here

# Cloudinary (Required for image upload to Gallery, Hero & Testimonials)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay (Optional - payment bookings will work as standard enquiries if left blank)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

